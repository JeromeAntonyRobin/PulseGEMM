#--  Synopsys, Inc.
#--  Synplify Pro Project for GEMM DMA Accelerator

#project files
add_file -verilog "/home/ubuntu/GEMMCNN/hdl/gemm_pe.v"
add_file -verilog "/home/ubuntu/GEMMCNN/hdl/gemm_skew_buffer.v"
add_file -verilog "/home/ubuntu/GEMMCNN/hdl/gemm_systolic_core.v"
add_file -verilog "/home/ubuntu/GEMMCNN/hdl/gemm_dma_top.v"

#implementation: "synthesis"
impl -add synthesis -type fpga

set_option -vlog_std sysv

#device options (PolarFire SoC Discovery Kit)
set_option -technology PolarFireSoC
set_option -part MPFS095T
set_option -package FCSG325
set_option -speed_grade -1

#compilation/mapping options
set_option -use_fsm_explorer 0
set_option -top_module "gemm_dma_top"
set_option -hdl_strict_syntax 0
set_option -frequency 50.000
set_option -resolve_multiple_driver 1
set_option -srs_instrumentation 1

#mapper_options
set_option -write_verilog 0
set_option -write_structural_verilog 0
set_option -write_vhdl 0
set_option -resource_sharing 1

#Microchip PolarFireSoC
set_option -automatic_compile_point 1
set_option -rom_map_logic 1
set_option -polarfire_ram_init 1
set_option -retiming 0

project -result_file "/home/ubuntu/GEMMCNN/synthesis/gemm_dma_top.vm"
impl -active "synthesis"
